+    /**
+     * Lite Social: shows a popup window full screen, with its own WebView linked to the opener
+     * (window.opener and the handle window.open returned both work). Back or window.close() closes it.
+     */
+    private boolean openPopupWindow(WebView opener, Message resultMsg) {
+        final Activity activity = mWebView.getThemedReactContext().getCurrentActivity();
+        if (activity == null || activity.isFinishing()) {
+            return false;
+        }
+
+        final WebView popup = new WebView(activity);
+        final WebSettings settings = popup.getSettings();
+        settings.setJavaScriptEnabled(true);
+        settings.setDomStorageEnabled(true);
+        // As a tablet, like the page that opens it (the app may have put the opener back on the
+        // phone user agent for its layout): Instagram only runs calls for a tablet or desktop.
+        settings.setUserAgentString(opener.getSettings().getUserAgentString().replace(" Mobile Safari/", " Safari/"));
+        settings.setMediaPlaybackRequiresUserGesture(false); // A call's sound starts without a tap.
+        settings.setAllowFileAccess(false);
+        settings.setAllowContentAccess(false);
+        settings.setMixedContentMode(WebSettings.MIXED_CONTENT_NEVER_ALLOW);
+        CookieManager.getInstance().setAcceptThirdPartyCookies(popup, true);
+
+        final FrameLayout container = new FrameLayout(activity);
+        container.setFitsSystemWindows(true); // Keep the page clear of the status and navigation bars.
+        container.addView(popup, FULLSCREEN_LAYOUT_PARAMS);
+
+        final Dialog dialog = new Dialog(activity, android.R.style.Theme_DeviceDefault_NoActionBar);
+        dialog.setContentView(container);
+        if (dialog.getWindow() != null) {
+            dialog.getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        }
+        dialog.setOnDismissListener(d -> {
+            container.removeAllViews();
+            popup.destroy();
+        });
+
+        popup.setWebViewClient(new WebViewClient() {
+            @Override
+            public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                // Web pages and in-page pseudo-addresses stay in the window (the same schemes as
+                // core/navigationPolicy.ts). Deep links (instagram://, intent://) never open other apps.
+                String scheme = request.getUrl().getScheme();
+                if (scheme == null) return false;
+                switch (scheme.toLowerCase(java.util.Locale.ROOT)) {
+                    case "http":
+                    case "https":
+                    case "about":
+                    case "data":
+                    case "blob":
+                    case "javascript":
+                        return false;
+                    default:
+                        return true;
+                }
+            }
+        });
+        popup.setWebChromeClient(new WebChromeClient() {
+            @Override
+            public void onPermissionRequest(PermissionRequest request) {
