<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android 13+: needed to show the alerts. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!--
    Lets Settings show Android's "Let Lite Social run in the background?" dialog,
    so battery optimization doesn't hold the background checks back for hours.
  -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- Reboots clear alarms: CheckAlarm sets the next check again. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <receiver
      android:name="com.jarod85.litesocial.alerts.CheckAlarm"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
